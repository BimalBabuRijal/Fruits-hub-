rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Standard Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn() && 
             request.auth.token.email == 'kopitebbr@gmail.com' && 
             request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation Blueprints
    function isValidFruit(data) {
      return data.keys().hasAll(['id', 'name', 'price', 'unit', 'image']) &&
             data.id is string && data.id.size() <= 64 &&
             data.name is string && data.name.size() <= 100 &&
             data.description is string && data.description.size() <= 500 &&
             data.price is number && data.price >= 0 &&
             data.unit is string && data.unit.size() <= 20 &&
             data.image is string && data.image.size() <= 1000000 && // Base64 strings can be large
             (data.get('type', '') == '' || data.type in ['tropical', 'berry', 'citrus', 'stone', 'melon', 'other']);
    }

    function isValidReward(data) {
      return data.keys().hasAll(['id', 'title', 'points', 'image', 'type']) &&
             data.id is string && data.id.size() <= 64 &&
             data.title is string && data.title.size() <= 100 &&
             data.points is number && data.points >= 0 &&
             data.image is string && data.image.size() <= 1000000 &&
             data.type in ['Gift Hamper', 'Voucher', 'Service'];
    }

    // Global Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Collections
    match /fruits/{fruitId} {
      allow read: if true;
      allow create, update: if isOwner() && isValidFruit(request.resource.data) && isValidId(fruitId);
      allow delete: if isOwner();
    }

    match /rewards/{rewardId} {
      allow read: if true;
      allow create, update: if isOwner() && isValidReward(request.resource.data) && isValidId(rewardId);
      allow delete: if isOwner();
    }
  }
}
