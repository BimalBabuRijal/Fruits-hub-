rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      // For this app, we trust the specific owner email
      return isSignedIn() && isEmailVerified() && request.auth.token.email == 'kopitebbr@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Helper functions for entity validation
    function isValidFruit(data) {
      return data.keys().hasAll(['id', 'name', 'price', 'unit', 'image', 'description']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.price is number && data.price >= 0 &&
             data.unit is string && data.unit.size() <= 20 &&
             data.image is string && data.image.size() <= 1000 &&
             data.description is string && data.description.size() <= 1000;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['itemId', 'userName', 'rating', 'comment', 'date']) &&
             data.itemId is string && data.itemId.size() <= 128 &&
             data.userName is string && data.userName.size() <= 100 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() <= 2000 &&
             data.date is string; // Using string for now as app uses ISO strings
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'points', 'avatar']) &&
             data.id == request.auth.uid &&
             data.name is string && data.name.size() <= 100 &&
             data.email == request.auth.token.email &&
             data.points is number &&
             data.avatar is string && data.avatar.size() <= 1000;
    }

    function isValidActivity(data) {
      return data.keys().hasAll(['type', 'title', 'amount', 'points', 'date']) &&
             data.type in ['Purchase', 'Redemption', 'Review'] &&
             data.title is string && data.title.size() <= 200 &&
             data.amount is number &&
             data.points is number &&
             data.date is string;
    }

    function isValidReward(data) {
       return data.keys().hasAll(['id', 'title', 'points', 'image', 'type']) &&
              data.id is string && data.id.size() <= 128 &&
              data.title is string && data.title.size() <= 100 &&
              data.points is number && data.points >= 0 &&
              data.image is string && data.image.size() <= 1000 &&
              data.type in ['Gift Hamper', 'Voucher', 'Service'];
    }

    // Match blocks
    match /fruits/{fruitId} {
      allow get, list: if true;
      allow write: if isAdmin() && (request.resource == null || isValidFruit(request.resource.data));
    }

    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidReview(request.resource.data);
      allow update, delete: if isAdmin();
    }

    match /rewards/{rewardId} {
      allow get, list: if true;
      allow write: if isAdmin() && (request.resource == null || isValidReward(request.resource.data));
    }

    match /users/{userId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && (
        // Only allow updating points (for redemptions) or basic info
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['points', 'name', 'avatar']) &&
        isValidUser(request.resource.data)
      ) || isAdmin();
    }

    match /users/{userId}/activities/{activityId} {
      allow get, list: if isOwner(userId);
      allow write: if isOwner(userId) && isValidActivity(request.resource.data);
    }

    match /settings/{settingId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }
  }
}
