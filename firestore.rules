rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'kopitebbr@gmail.com' && request.auth.token.email_verified == true;
    }
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users collection
    match /users/{userId} {
      function isValidUser(data) {
        return data.id == userId &&
               data.name is string && data.name.size() <= 100 &&
               data.email is string && data.email.size() <= 100 &&
               data.points is number;
      }
      
      allow get: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if (isOwner(userId) || isAdmin()) && isValidUser(request.resource.data) && (
        isAdmin() || (
          // Users can only change points when redeeming or earning through valid actions, 
          // but strictly we'll allow points update for now as the app handles it.
          // In a production app, we'd use cloud functions for points.
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points', 'name', 'avatar'])
        )
      );

      // User activities subcollection
      match /activities/{activityId} {
        function isValidActivity(data) {
          return data.type in ['Purchase', 'Redemption', 'Review'] &&
                 data.title is string && data.title.size() <= 200 &&
                 data.amount is number &&
                 data.points is number &&
                 data.date is string;
        }
        allow list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidActivity(request.resource.data);
      }
    }

    // Fruits collection
    match /fruits/{fruitId} {
      function isValidFruit(data) {
        return data.id is string && data.id.size() <= 50 &&
               data.name is string && data.name.size() <= 100 &&
               data.price is number &&
               data.unit is string &&
               data.image is string;
      }
      allow read: if true;
      allow write: if isAdmin() && isValidFruit(request.resource.data);
    }

    // Rewards collection
    match /rewards/{rewardId} {
      function isValidReward(data) {
        return data.id is string && data.id.size() <= 50 &&
               data.title is string && data.title.size() <= 100 &&
               data.points is number &&
               data.image is string &&
               data.type in ['Gift Hamper', 'Voucher', 'Service'];
      }
      allow read: if true;
      allow write: if isAdmin() && isValidReward(request.resource.data);
    }

    // Reviews collection
    match /reviews/{reviewId} {
      function isValidReview(data) {
        return data.itemId is string &&
               data.userName is string &&
               data.rating is number && data.rating >= 1 && data.rating <= 5 &&
               data.comment is string && data.comment.size() <= 1000 &&
               data.date is string;
      }
      allow read: if true;
      allow create: if isSignedIn() && isValidReview(request.resource.data);
      allow delete: if isAdmin();
    }

    // Settings collection
    match /settings/company {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
