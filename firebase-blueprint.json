{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Public and private user data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "points": { "type": "number" },
        "avatar": { "type": "string" }
      },
      "required": ["id", "name", "email", "points"]
    },
    "UserActivity": {
      "title": "User Activity",
      "description": "Log of purchases, redemptions, and reviews",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["Purchase", "Redemption", "Review"] },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "points": { "type": "number" },
        "date": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "title", "amount", "points", "date"]
    },
    "Fruit": {
      "title": "Fruit",
      "description": "Fruit item available for sale",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "unit": { "type": "string" },
        "image": { "type": "string" },
        "type": { "type": "string", "enum": ["tropical", "berry", "citrus", "stone", "melon", "other"] }
      },
      "required": ["id", "name", "price", "unit", "image"]
    },
    "Reward": {
      "title": "Reward",
      "description": "Loyalty reward available for redemption",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "points": { "type": "number" },
        "image": { "type": "string" },
        "type": { "type": "string", "enum": ["Gift Hamper", "Voucher", "Service"] }
      },
      "required": ["id", "title", "points", "image", "type"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer review for a fruit or package",
      "type": "object",
      "properties": {
        "itemId": { "type": "string" },
        "itemName": { "type": "string" },
        "userName": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "date": { "type": "string", "format": "date-time" }
      },
      "required": ["itemId", "userName", "rating", "comment", "date"]
    },
    "Settings": {
      "title": "App Settings",
      "description": "Global application settings",
      "type": "object",
      "properties": {
        "paymentQR": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/users/{userId}/activities/{activityId}": {
      "schema": "UserActivity",
      "description": "User specific activity logs"
    },
    "/fruits/{fruitId}": {
      "schema": "Fruit",
      "description": "Available fruits"
    },
    "/rewards/{rewardId}": {
      "schema": "Reward",
      "description": "Redeemable rewards"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Public customer reviews"
    },
    "/settings/company": {
      "schema": "Settings",
      "description": "Company global settings"
    }
  }
}
