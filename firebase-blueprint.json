{
  "entities": {
    "Fruit": {
      "title": "Fruit",
      "description": "Information about a fruit available in the store.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "unit": { "type": "string" },
        "image": { "type": "string" },
        "type": { "type": "string", "enum": ["tropical", "berry", "citrus", "stone", "melon", "other"] }
      },
      "required": ["id", "name", "price", "unit", "image"]
    },
    "Reward": {
      "title": "Reward",
      "description": "A voucher or reward available for points.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "points": { "type": "number" },
        "image": { "type": "string" },
        "type": { "type": "string", "enum": ["Gift Hamper", "Voucher", "Service"] }
      },
      "required": ["id", "title", "points", "image", "type"]
    },
    "Report": {
      "title": "Report",
      "description": "A health report record.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": "string", "enum": ["Normal", "Action Required"] },
        "summary": { "type": "string" },
        "date": { "type": "string" },
        "image": { "type": "string" }
      },
      "required": ["id", "title", "status", "summary", "date"]
    }
  },
  "firestore": {
    "fruits/{fruitId}": {
      "schema": "Fruit",
      "description": "Collection of available fruits."
    },
    "rewards/{rewardId}": {
      "schema": "Reward",
      "description": "Collection of rewards and vouchers."
    },
    "users/{userId}/reports/{reportId}": {
      "schema": "Report",
      "description": "User's health reports."
    }
  }
}
